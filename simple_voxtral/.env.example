# Configuration pour la démo Voxtral Live (ASR Temps Réel + Traduction)

# URL de base de l'API LLMaaS
# L'endpoint WebSocket /v1/realtime sera automatiquement construit
API_URL="https://api.ai.cloud-temple.com"

# Votre clé API LLMaaS (Bearer Token)
API_KEY="votre_cle_api_ici"

# Modèle Voxtral pour la transcription (laisser par défaut sauf besoin spécifique)
DEFAULT_MODEL="mistralai/Voxtral-Mini-4B-Realtime-2602"

# Modèle de traduction (utilisé avec l'option -t / --translate)
TRANSLATE_MODEL="translategemma:12b"
